# Copie para `.env.local` (dev) ou configure no painel da Vercel. No build estático os valores
# NEXT_PUBLIC_* são gravados no JavaScript: mudou aqui -> rode `npm run build` de novo e reenvie `out/`.
# Nada secreto aqui. Chaves e tokens ficam no SERVIDOR que recebe o POST (Make, n8n, PHP…).

# URL que recebe o POST JSON do formulário. Vazio = modo DEMO (só simula sucesso; nada é enviado).
NEXT_PUBLIC_LEAD_ENDPOINT=

# Link do grupo do WhatsApp (https://chat.whatsapp.com/CODIGO). Padrão: #grupo-whatsapp
NEXT_PUBLIC_GROUP_URL=#grupo-whatsapp

# Início da 1ª noite (ISO com -03:00). As noites 2 e 3 são +1 e +2 dias; cada noite dura 2 h.
NEXT_PUBLIC_EVENT_START=2026-11-09T20:30:00-03:00

# URL pública final do site (sem barra no fim). Usada em og:image, canonical e metadataBase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hospedagem em SUBPASTA (ex.: seudominio.com/black/): /black. Vazio = raiz do domínio. Vale no build.
NEXT_PUBLIC_BASE_PATH=

# 1 = Lenis (rolagem suave) ligado no desktop. Padrão: desligado.
NEXT_PUBLIC_SMOOTH_SCROLL=0

# 1 = pede aos buscadores para NÃO indexar (padrão nas páginas de comparação). Use 0 só na versão final.
NEXT_PUBLIC_NOINDEX=1
